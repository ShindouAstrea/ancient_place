# =============================================================================
# Variables de entorno. Copiar a `.env.local` para desarrollo:  cp .env.example .env.local
# NUNCA versionar archivos .env con valores reales.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) VARIABLES PÚBLICAS DE BUILD (NEXT_PUBLIC_*)
#    - Next.js las INCRUSTA en el JavaScript durante `next build`.
#    - Cambiarlas requiere volver a construir (en Docker: --build-arg; en Vercel: redeploy).
#    - Son visibles para cualquier visitante: NUNCA poner secretos aquí.
# -----------------------------------------------------------------------------

# URL pública del sitio, sin "/" final. Producción: https://dominio.cl
# Se admite sin protocolo ("dominio.cl" → https://dominio.cl). En Vercel puede omitirse:
# se usa automáticamente el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Local: ejecutar `pnpm db:start` y copiar "API URL" y "Publishable key"
# de `supabase status`. Producción: Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# CAPTCHA (Cloudflare Turnstile) del formulario de contacto y del login del panel.
# Activo por defecto. "false" lo desactiva y entonces NEXT_PUBLIC_TURNSTILE_SITE_KEY y
# TURNSTILE_SECRET_KEY pasan a ser opcionales (útil mientras no se configura Turnstile).
# Si se desactiva, también debe estar desactivado en Supabase (Authentication → CAPTCHA).
NEXT_PUBLIC_TURNSTILE_ENABLED=true

# Cloudflare Turnstile (site key pública). Este valor es la clave de PRUEBA
# oficial de Cloudflare que siempre aprueba; usar la real en producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------------------
# 2) VARIABLES DE SERVIDOR / RUNTIME (secretas)
#    - Se leen al iniciar el servidor; no requieren reconstruir.
#    - Docker: `docker run --env-file ...` o `-e`. Vercel: Settings → Environment Variables.
#    - Se validan al arrancar (src/instrumentation.ts): si falta alguna, el servidor no inicia.
# -----------------------------------------------------------------------------

# Clave secreta de Turnstile. Este valor es la clave de PRUEBA que siempre aprueba.
# El mismo par de claves protege el login del panel: en producción esta clave secreta
# también se configura en Supabase (Authentication → CAPTCHA). Ver README.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# API key de Resend (https://resend.com/api-keys). Debe comenzar con "re_".
RESEND_API_KEY=re_reemplazar

# Sal secreta para el hash de IP del rate limiting (mínimo 32 caracteres).
# Generar con:  openssl rand -hex 32
RATE_LIMIT_SALT=reemplazar-con-un-valor-aleatorio-de-al-menos-32-caracteres

# Secreto compartido con las funciones crear_lead() y verificar_rate_limit() de la
# base de datos (Supabase Vault, nombre "formulario_secreto"). Impide crear leads
# llamando directamente a la API de Supabase con la clave pública.
# El valor de abajo es SOLO para desarrollo local (coincide con supabase/seed.sql).
# Producción: generar uno nuevo con  openssl rand -hex 32  y guardarlo en Vault (ver README).
SUPABASE_FORMULARIO_SECRETO=local-dev-secreto-formulario-no-usar-en-produccion

# OPCIONAL. Solo si la app corre en Docker y Supabase local en el host:
# dentro del contenedor 127.0.0.1 es el propio contenedor, así que el servidor
# debe usar esta URL (docker-compose.yml ya la define para desarrollo).
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321

# IMPORTANTE: SUPABASE_SERVICE_ROLE_KEY NO se usa en este proyecto. No agregarla.
